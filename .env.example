# انسخ هذا الملف باسم .env واملأ القيم من لوحة ميتا
# (developers.facebook.com ← تطبيقك ← WhatsApp ← API Setup)

# توكن الوصول (Access Token)
WHATSAPP_TOKEN=

# معرّف رقم الهاتف (Phone number ID) — رقم طويل، وليس رقم الواتساب نفسه
PHONE_NUMBER_ID=

# كلمة سر تختارها أنت، وتكتب نفسها في خانة Verify token عند ضبط الويب هوك
VERIFY_TOKEN=eservices-bot-verify

# (اختياري) رقم واتساب الموظف لاستقبال إشعارات الطلبات الجديدة
# بصيغة رمز الدولة بدون + أو أصفار، مثال للسعودية: 9665XXXXXXXX
EMPLOYEE_NUMBER=

# منفذ السيرفر المحلي
PORT=3000
